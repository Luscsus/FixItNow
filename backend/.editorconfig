root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.java]
indent_size = 4
continuation_indent_size = 8

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

[*.json]
indent_size = 2

[*.{md,markdown}]
max_line_length = off
trim_trailing_whitespace = false

[*.properties]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[{Dockerfile,*.dockerfile}]
indent_size = 4
